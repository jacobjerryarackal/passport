# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (SQLite default for zero-friction local development)
DATABASE_URL="file:./dev.db"

# PayPal Developer Sandbox Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret_here"
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"

# Demo Mode Configuration (true enables simulated webhook route /api/webhooks/demo)
DEMO_MODE=false

# Google Gemini API & Resilience Configuration
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_PRIMARY_MODEL="gemini-3.1-pro-preview"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"
GEMINI_SIMULATE_429=false

