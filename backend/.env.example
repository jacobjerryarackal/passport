# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (SQLite default for zero-friction local development)
DATABASE_URL="file:./dev.db"

# PayPal Developer Sandbox Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret_here"
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"

# Google Gemini API Key (Gemini 1.5 Pro Agent & Dispute Autopsy)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

